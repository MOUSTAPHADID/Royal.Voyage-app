{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "public-preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "public"
      }
    },
    "public-production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "public"
      }
    },
    "admin-internal": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin"
      }
    },
    "admin-preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "admin"
      }
    }
  }
}
